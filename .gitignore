# Data files are too large for GitHub; each member downloads them locally
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python / Jupyter
__pycache__/
.ipynb_checkpoints/
.venv/
*.pyc

# Quarto render output
*_files/
.quarto/

# OS
.DS_Store

# Small cleaned tables are shared in the repo so teammates can start without rerunning notebook 01.
# trips_clean.csv and station_events.csv stay local (over GitHub's 100 MB limit).
!data/processed/station_day.csv
!data/processed/station_day_by_rider.csv
!data/processed/weather_daily.csv
!data/processed/exclusions.csv

# Rendered check-in HTML is regenerated before submitting; only the notebook is tracked
checkin/*.html
